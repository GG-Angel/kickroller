@api = http://localhost:8000
@metrics = http://localhost:9100
# Stands in for the JWT subject until auth lands (see core/auth.py).
@userId = 01900000-0000-7000-8000-0000000000aa
# Audio file for steps 1-2, relative to this file.
@audioFile = sample.mp3

### Health check
GET {{api}}/health

### Prometheus metrics
GET {{metrics}}/metrics

### OpenAPI schema
GET {{api}}/openapi.json

### Step 1: Create an upload and get a signed POST form
# @name createUpload
POST {{api}}/me/uploads
Content-Type: application/json
X-User-Id: {{userId}}

{
  "filename": "{{audioFile}}"
}

### Step 2: POST the audio with the signed form fields
POST {{createUpload.response.body.upload_url}}
Content-Type: multipart/form-data; boundary=form

--form
Content-Disposition: form-data; name="key"

{{createUpload.response.body.$.upload_fields['key']}}
--form
Content-Disposition: form-data; name="x-amz-algorithm"

{{createUpload.response.body.$.upload_fields['x-amz-algorithm']}}
--form
Content-Disposition: form-data; name="x-amz-credential"

{{createUpload.response.body.$.upload_fields['x-amz-credential']}}
--form
Content-Disposition: form-data; name="x-amz-date"

{{createUpload.response.body.$.upload_fields['x-amz-date']}}
--form
Content-Disposition: form-data; name="policy"

{{createUpload.response.body.$.upload_fields['policy']}}
--form
Content-Disposition: form-data; name="x-amz-signature"

{{createUpload.response.body.$.upload_fields['x-amz-signature']}}
--form
Content-Disposition: form-data; name="Content-Type"

audio/mpeg
--form
Content-Disposition: form-data; name="file"; filename="{{audioFile}}"
Content-Type: audio/mpeg

< ./{{audioFile}}
--form--

### Step 3: List your tracks to find the new one
# The track appears once validation accepts the upload.
# @name listTracks
GET {{api}}/me/tracks?limit=20
X-User-Id: {{userId}}

@trackId = {{listTracks.response.body.$.items[0].id}}

### Step 4: Get the track
GET {{api}}/me/tracks/{{trackId}}
X-User-Id: {{userId}}

### Step 5: Rename the track
PATCH {{api}}/me/tracks/{{trackId}}
X-User-Id: {{userId}}
Content-Type: application/json

{
  "title": "New title",
  "artist": "New artist"
}

### Step 6: Get a presigned playback URL
# @name playback
POST {{api}}/me/tracks/{{trackId}}/playback-url
X-User-Id: {{userId}}

### Step 7: Stream the audio from the playback URL
GET {{playback.response.body.url}}

### Step 8: Remove the track
DELETE {{api}}/me/tracks/{{trackId}}
X-User-Id: {{userId}}
